# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA suba o arquivo ".env" para o GitHub (ele já está no .gitignore).

# Chave secreta usada pelo Flask para assinar a sessão.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Credenciais do banco de dados MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio_db

# Login do painel administrativo (/admin)
ADMIN_USERNAME=admin
# Gere o hash da sua senha com:
# python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('sua_senha_aqui'))"
ADMIN_PASSWORD_HASH=

# Deixe "false" em produção. Só use "true" no seu computador, durante o desenvolvimento.
FLASK_DEBUG=false

# ---------------------------------------------------------------------------
# Armazenamento de imagens (Cloudflare R2)
#
# Necessário em produção no Render: sem isso, as imagens enviadas pelo painel
# admin são salvas no disco local do serviço, que é APAGADO a cada deploy,
# restart ou hibernação (plano free). Configure essas variáveis para que os
# uploads fiquem persistentes num bucket R2. Veja o guia em UPLOADS_R2.md.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL pública do bucket (sem barra no final), ex:
# https://pub-xxxxxxxxxxxxxxxx.r2.dev  ou  https://imagens.seudominio.com
R2_PUBLIC_BASE_URL=
