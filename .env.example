# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA suba o arquivo ".env" para o GitHub (ele já está no .gitignore).

# Chave secreta usada pelo Flask para assinar a sessão.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Credenciais do banco de dados MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio_db

# Login do painel administrativo (/admin)
ADMIN_USERNAME=admin
# Gere o hash da sua senha com:
# python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('sua_senha_aqui'))"
ADMIN_PASSWORD_HASH=

# Deixe "false" em produção. Só use "true" no seu computador, durante o desenvolvimento.
FLASK_DEBUG=false
